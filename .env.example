# Include /api. Devices cannot reach the computer through localhost.
# This points to the existing backend, which owns the Supabase/JWT/mail credentials.
# Keep backend secrets out of this file and out of all EXPO_PUBLIC_* variables.
EXPO_PUBLIC_API_URL=http://192.168.1.100:5000/api
# Optional: used only by development browser previews on localhost, 127.0.0.1, or [::1].
# Phones, remote browser previews, and release builds continue using EXPO_PUBLIC_API_URL.
# EXPO_PUBLIC_WEB_API_URL=http://localhost:5000/api
# Public identifiers for the linked @4dmin01/edumatch EAS project.
# The same defaults are committed in app.config.ts for fresh checkouts.
EXPO_PUBLIC_EAS_PROJECT_ID=16f46295-63ba-4cd3-89aa-7874be0a09e8
EXPO_OWNER=4dmin01
EXPO_ANDROID_PACKAGE=com.edumatch.mobile
EXPO_IOS_BUNDLE_IDENTIFIER=com.edumatch.mobile
# Optional paths to the Firebase configuration for development/release builds.
GOOGLE_SERVICES_JSON=
GOOGLE_SERVICES_PLIST=

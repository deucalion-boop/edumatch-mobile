# Configure these on the backend service, using your existing backend values.
# This example contains no credentials.
NODE_ENV=production
JWT_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=
SUPABASE_STORAGE_PUBLIC=false
REDIS_URL=
# Set this for the hosting platform's verified proxy configuration.
TRUST_PROXY=
# Your existing HTTPS web frontend, used for password-reset email links.
FRONTEND_URL=
# Optional comma-separated exact HTTPS origins; otherwise FRONTEND_URL is used.
CORS_ALLOWED_ORIGINS=
# Math CAPTCHA shares REDIS_URL with rate limiting. No CAPTCHA keys are needed.
MAIL_API_URL=
MAIL_API_KEY=
EXPO_PROJECT_ID=16f46295-63ba-4cd3-89aa-7874be0a09e8
